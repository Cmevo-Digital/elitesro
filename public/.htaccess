RewriteEngine On

# http → https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www → non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# removed services → services overview
RewriteRule ^servicii/(mobilier-evenimente|corturi-evenimente|mese-scaune|vesela-tacamuri)(/.*)?$ /servicii/ [R=301,L]

# no-trailing-slash → trailing-slash (only for real page directories, not files)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
